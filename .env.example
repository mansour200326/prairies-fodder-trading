# Resend API key — get one at https://resend.com/api-keys
# If unset, the quote API logs submissions and returns success (safe for local dev).
RESEND_API_KEY=

# Address that quote-request emails are delivered to.
QUOTE_TO_EMAIL=hello@prairiesfodder.ae

# Verified sender address / domain configured in Resend.
# Defaults to onboarding@resend.dev (Resend's shared sandbox sender) if unset.
QUOTE_FROM_EMAIL=Prairies Fodder <onboarding@resend.dev>

# Absolute site URL, used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://prairiesfodder.ae
